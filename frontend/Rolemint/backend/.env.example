# Postgres connection string
DATABASE_URL=postgres://rolemint:rolemint@localhost:5432/rolemint

# Secret used to sign JWTs — set this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Server port
PORT=4000

# Anthropic API key used to power the roleplay AI and feedback scoring
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for chat + feedback generation (override if you use a different model)
AI_MODEL=claude-sonnet-4-5-20250929

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
