# Server Configuration
PORT=5000
FRONTEND_URL=https://my-project-eta-sepia.vercel.app
VITE_API_URL=/api

# AI Service Keys (Optional: Resilient fallback mode active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (Optional: Persistent storage active if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillbridge?retryWrites=true&w=majority

# Supabase (Optional)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
